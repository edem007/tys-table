# Ty's Table — Environment Variables
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.

# ── Upstash Redis ────────────────────────────────────────────────
# Get these from https://upstash.com → your Redis database → REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Anthropic Claude API ─────────────────────────────────────────
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Cron Security (optional but recommended) ─────────────────────
# A random secret that protects the /api/cron/daily-suggest endpoint.
# Generate with: openssl rand -hex 24
# Also set this in Vercel → Settings → Environment Variables.
CRON_SECRET=your_random_secret_here

# ── Supabase (coming soon — Phase 2) ────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe (coming soon — Phase 4) ──────────────────────────────
# Get these from https://dashboard.stripe.com → Developers → API Keys
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id
# STRIPE_PRO_ANNUAL_PRICE_ID=price_your_pro_annual_price_id

# ── Resend Email (coming soon — Phase 2) ─────────────────────────
# Get your key from https://resend.com → API Keys
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=hello@tystable.app
