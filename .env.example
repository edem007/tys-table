# Ty's Table — Environment Variables
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.

# ── Supabase ───────────────────────────────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side only, bypasses RLS — used by cron/email/admin routes.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Stripe ───────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id

# ── Resend Email ──────────────────────────────────────────────────
# Get your key from https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=hello@tystable.app

# ── Restaurant + recipe matching ──────────────────────────────────
# Google Cloud Console → enable "Places API (New)" → Credentials
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# ── Cron Security (optional but recommended) ─────────────────────
# A random secret that protects the /api/email/weekly-digest endpoint.
# Generate with: openssl rand -hex 24
# Also set this in Vercel → Settings → Environment Variables.
CRON_SECRET=your_random_secret_here

# ── App URL (used in email links + Stripe redirect URLs) ─────────
NEXT_PUBLIC_APP_URL=https://tystable.app
